# ─── Development Environment Variables ───────────────────────────────────────
# Copy this file to .env.dev and fill in your values:
#   cp .env.dev.example .env.dev
#
# .env.dev is git-ignored. This file (.env.dev.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# ── HMR / File-watching (required for Docker volume mounts) ──────────────────
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# ── NextAuth ──────────────────────────────────────────────────────────────────
# In development, NEXTAUTH_URL must match the address you open in your browser.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-replace-in-production

# ── Google SSO (optional) ─────────────────────────────────────────────────────
# Button stays hidden unless BOTH are set. See GOOGLE_SSO.md.
# Register http://localhost:3000/api/auth/google/callback as a redirect URI
# (Google allows plain http only for localhost). NEXTAUTH_URL above must match.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=babcock.edu.ng

# ── Backend API (uncomment and set when backend is ready) ─────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_URL=your-backend-api

# ── TLS / SSL ─────────────────────────────────────────────────────────────────
# TEMPORARY: Set to 0 if the backend SSL certificate is expired/invalid so that
# Node.js can still connect. Remove once the certificate is renewed.
NODE_TLS_REJECT_UNAUTHORIZED=0
