# ─── Production Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in real values on the Debian server:
#   cp .env.example .env
#   nano .env
#
# .env is git-ignored. This file (.env.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── NextAuth ──────────────────────────────────────────────────────────────────
# NEXTAUTH_URL must match the public URL users access the app from.
NEXTAUTH_URL=https://your-domain.com

# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# ── Google SSO (optional) ─────────────────────────────────────────────────────
# The "Sign in with your Babcock email" button only appears when BOTH the client ID and
# secret are set. Leave them empty/unset to keep SSO switched off.
# Setup steps: GOOGLE_SSO.md
#
# Redirect URI to register in Google Cloud Console (must match exactly):
#   <APP_URL or NEXTAUTH_URL>/api/auth/google/callback
# Google requires https:// for any host other than localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. An entry also matches its subdomains, so babcock.edu.ng covers
# student.babcock.edu.ng and pg.babcock.edu.ng. To allow students only, use:
#   student.babcock.edu.ng,pg.babcock.edu.ng
GOOGLE_ALLOWED_DOMAINS=babcock.edu.ng
# Optional. Public origin used to build the redirect URI; defaults to NEXTAUTH_URL.
# APP_URL=https://your-domain.com

# ── Backend API (uncomment and set when backend is ready) ─────────────────────
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
API_URL=your-backend-api

# ── TLS / SSL ─────────────────────────────────────────────────────────────────
# TEMPORARY: Set to 0 if the backend SSL certificate is expired/invalid so that
# Node.js can still connect over HTTPS. Remove once the certificate is renewed.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Coming soon (preview) features ───────────────────────────────────────────
# Controls the features listed under "Coming soon" in the sidebar (lib/features.ts).
#   all   → every preview feature on
#   none  → every preview feature off (V1 release)
#   courses,attendance,insights,today,notifications → only the listed ones
# Not set: ON in `npm run dev`, OFF in production builds. Read at build time,
# so rebuild after changing it.
# NEXT_PUBLIC_PREVIEW_FEATURES=none

# ── Student phase-1 features (Course Spaces, attendance, insights, notifications) ──
# "mock" (default, demo data in the browser) or "live" (calls /api/student/* → ${API_URL}/api/v1/student/*)
NEXT_PUBLIC_STUDENT_API_MODE=mock

# ── Web push ──────────────────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ict@babcock.edu.ng
# Shared secret the backend sends as "Authorization: Bearer ..." to POST /api/push/send
PUSH_SEND_SECRET=

# ── AI chat assistant ─────────────────────────────────────────────────────────
# Tries AI_CHAT_MODEL, then AI_CHAT_FALLBACK_MODEL if the first fails before answering.
# Write models as "google:<id>" (Gemini API) or "nvidia:<id>" (build.nvidia.com).
# A model whose API key is missing is skipped. Set AI_CHAT_FALLBACK_MODEL= (empty) for no backup.
# GOOGLE_GENERATIVE_AI_API_KEY=
# NVIDIA_API_KEY=
# AI_CHAT_MODEL=google:gemini-3.5-flash-lite
# AI_CHAT_FALLBACK_MODEL=nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
